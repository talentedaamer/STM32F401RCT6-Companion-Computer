  72              	
  73              	/*--------------------------------------------------------------------------*
  74              	 * Performs a context switch between two threads.
  75              	 *--------------------------------------------------------------------------*/
  76              	                .thumb_func
  77              	                .globl  __port_switch
  78              	__port_switch:
  79 0000 2DE9F04F 	                push    {r4, r5, r6, r7, r8, r9, r10, r11, lr}
  80              	#if CORTEX_USE_FPU
  81              	                /* Saving FPU context.*/
  82              	                vpush   {s16-s31}
  83              	#endif
  84              	
  85 0004 C1F80CD0 	                str     sp, [r1, #CONTEXT_OFFSET]
  86              	#if (CORTEX_SIMPLIFIED_PRIORITY == FALSE) &&                                \
  87              	    ((CORTEX_MODEL == 3) || (CORTEX_MODEL == 4))
  88              	                /* Workaround for ARM errata 752419, only applied if
  89              	                   condition exists for it to be triggered.*/
  90 0008 C368     	                ldr     r3, [r0, #CONTEXT_OFFSET]
  91 000a 9D46     	                mov     sp, r3
  92              	#else
  93              	                ldr     sp, [r0, #CONTEXT_OFFSET]
  94              	#endif
  95              	
  96              	#if CORTEX_USE_FPU
  97              	                /* Restoring FPU context.*/
  98              	                vpop    {s16-s31}
  99              	#endif
 100 000c BDE8F08F 	                pop     {r4, r5, r6, r7, r8, r9, r10, r11, pc}
 101              	
 102              	/*--------------------------------------------------------------------------*
 103              	 * Start a thread by invoking its work function.
 104              	 *
 105              	 * Threads execution starts here, the code leaves the system critical zone
 106              	 * and then jumps into the thread function passed in register R4. The
 107              	 * register R5 contains the thread parameter. The function chThdExit() is
 108              	 * called on thread function return.
 109              	 *--------------------------------------------------------------------------*/
 110              	                .thumb_func
 111              	                .globl  __port_thread_start
ARM GAS  /tmp/cc3FWSy9.s 			page 6


 112              	__port_thread_start:
 113              	#if CH_DBG_ENABLE_STACK_CHECK && PORT_ENABLE_GUARD_PAGES
 114              	                bl      __port_set_region
 115              	#endif
 116              	#if CH_DBG_SYSTEM_STATE_CHECK
 117              	                bl      __dbg_check_unlock
 118              	#endif
 119              	#if CH_DBG_STATISTICS
 120              	                bl      __stats_stop_measure_crit_thd
 121              	#endif
 122              	#if CH_CFG_SMP_MODE == TRUE
 123              	                bl      __port_spinlock_release
 124              	#endif
 125              	#if CORTEX_SIMPLIFIED_PRIORITY
 126              	                cpsie   i
 127              	#else
 128 0010 0023     	                movs    r3, #0              /* CORTEX_BASEPRI_DISABLED */
 129 0012 83F31188 	                msr     BASEPRI, r3
 130              	#endif
 131 0016 2846     	                mov     r0, r5
 132 0018 A047     	                blx     r4
 133 001a 0020     	                movs    r0, #0              /* MSG_OK */
 134 001c FFF7FEFF 	                bl      chThdExit
 135 0020 FEE7     	1:              b       1b
 136              	
 137              	/*--------------------------------------------------------------------------*
 138              	 * Post-IRQ switch code.
 139              	 *
 140              	 * Exception handlers return here for context switching.
 141              	 *--------------------------------------------------------------------------*/
 142              	                .thumb_func
 143              	                .globl  __port_switch_from_isr
 144              	__port_switch_from_isr:
 145              	#if CH_DBG_STATISTICS
 146              	                bl      __stats_start_measure_crit_thd
 147              	#endif
 148              	#if CH_DBG_SYSTEM_STATE_CHECK
 149              	                bl      __dbg_check_lock
 150              	#endif
 151 0022 FFF7FEFF 	                bl      chSchDoPreemption
 152              	#if CH_DBG_SYSTEM_STATE_CHECK
 153              	                bl      __dbg_check_unlock
 154              	#endif
 155              	#if CH_DBG_STATISTICS
 156              	                bl      __stats_stop_measure_crit_thd
 157              	#endif
 158              	                .globl  __port_exit_from_isr
 159              	__port_exit_from_isr:
 160              	#if CORTEX_SIMPLIFIED_PRIORITY
 161              	                movw    r3, #:lower16:SCB_ICSR
 162              	                movt    r3, #:upper16:SCB_ICSR
 163              	                mov     r2, ICSR_PENDSVSET
 164              	                str     r2, [r3, #0]
 165              	#if CH_CFG_SMP_MODE == TRUE
 166              	                bl      __port_spinlock_release
 167              	#endif
 168              	                cpsie   i
